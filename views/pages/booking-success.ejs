<div class="max-w-xl mx-auto py-8 animate-pop-in">
  <div class="glass-card p-8 text-center space-y-6">

    <!-- Success Badge -->
    <div class="w-16 h-16 rounded-full bg-brand-50 border-2 border-brand-200 text-brand-800 flex items-center justify-center mx-auto shadow-xs">
      <i data-lucide="check" class="w-8 h-8 stroke-[3]"></i>
    </div>

    <div>
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-1">Reservation Received</span>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Booking Confirmed!</h1>
      <p class="text-xs text-slate-500 mt-1">A copy of this confirmation has been queued for your email.</p>
    </div>

    <!-- Reference Code Pill -->
    <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 inline-block w-full">
      <span class="text-[11px] text-slate-400 font-semibold block uppercase tracking-wider mb-1">Your Booking Reference</span>
      <span class="font-mono-code text-2xl font-extrabold text-brand-800 tracking-wider select-all"><%= reservation.reference_code %></span>
      <span class="text-[10px] text-slate-400 block mt-1">Please save or screenshot this code to present upon arrival.</span>
    </div>

    <!-- Booking Details Table -->
    <div class="p-4 rounded-xl bg-white border border-slate-200/90 text-left text-xs space-y-2.5">
      <div class="flex justify-between py-1 border-b border-slate-100">
        <span class="text-slate-500">Player Name:</span>
        <span class="font-bold text-slate-800"><%= reservation.player_name %></span>
      </div>
      <div class="flex justify-between py-1 border-b border-slate-100">
        <span class="text-slate-500">Court:</span>
        <span class="font-bold text-slate-800"><%= court ? court.name : 'Court #' + reservation.court_id %></span>
      </div>
      <div class="flex justify-between py-1 border-b border-slate-100">
        <span class="text-slate-500">Date:</span>
        <span class="font-bold text-slate-800"><%= formatDateDisplay(reservation.booking_date) %></span>
      </div>
      <div class="flex justify-between py-1 border-b border-slate-100">
        <span class="text-slate-500">Time:</span>
        <span class="font-bold text-slate-800 font-mono-code"><%= formatTime12(reservation.start_time) %> - <%= formatTime12(reservation.end_time) %></span>
      </div>
      <div class="flex justify-between py-1 border-b border-slate-100">
        <span class="text-slate-500">Total Paid / Due:</span>
        <span class="font-extrabold text-brand-800"><%= formatCurrency(reservation.total_price) %></span>
      </div>
      <div class="flex justify-between py-1 border-b border-slate-100">
        <span class="text-slate-500">GCash Reference:</span>
        <span class="font-mono-code text-slate-700 font-semibold"><%= reservation.gcash_reference_no || 'Pending' %></span>
      </div>
      <div class="flex justify-between pt-1">
        <span class="text-slate-500">Status:</span>
        <span class="badge-confirmed"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Confirmed / Pending Verification</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <button onclick="window.print()" class="btn-secondary-white flex-1 text-xs py-2.5">
        <i data-lucide="printer" class="w-4 h-4 text-slate-500"></i>
        <span>Print Receipt</span>
      </button>
      <a href="/" class="btn-primary-green flex-1 text-xs py-2.5">
        <i data-lucide="calendar-plus" class="w-4 h-4"></i>
        <span>Book Another Court</span>
      </a>
    </div>

  </div>
</div>
