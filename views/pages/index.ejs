<div class="space-y-8 animate-fade-in">

  <!-- Hero Section -->
  <div class="glass-card p-6 sm:p-10 relative overflow-hidden">
    <div class="max-w-2xl relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-100 text-brand-800 text-xs font-bold mb-4">
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-brand-600"></i>
        <span>Official Real-Time Reservation Portal</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
        <%= venueName %>
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
        <%= venueDescription || 'Premium sports courts available for hourly booking. Select your preferred court, pick your slots, and complete your reservation seamlessly with instant GCash payment.' %>
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-slate-600">
        <div class="flex items-center gap-1.5 bg-slate-100/80 px-3 py-1.5 rounded-lg border border-slate-200">
          <i data-lucide="clock" class="w-4 h-4 text-brand-700"></i>
          <span><%= formatTime12(openTime) %> - <%= formatTime12(closeTime) %> Daily</span>
        </div>
        <div class="flex items-center gap-1.5 bg-slate-100/80 px-3 py-1.5 rounded-lg border border-slate-200">
          <i data-lucide="map-pin" class="w-4 h-4 text-brand-700"></i>
          <span><%= venueAddress || 'Main Athletic Facility' %></span>
        </div>
        <div class="flex items-center gap-1.5 bg-slate-100/80 px-3 py-1.5 rounded-lg border border-slate-200">
          <i data-lucide="credit-card" class="w-4 h-4 text-brand-700"></i>
          <span>GCash Verified</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Booking Form -->
  <form id="reservationForm" action="/checkout-step" method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <input type="hidden" name="court_id" id="selectedCourtId" value="<%= courts.length > 0 ? courts[0].id : '' %>">
    <input type="hidden" name="booking_date" id="selectedDateInput" value="<%= selectedDate %>">
    <input type="hidden" name="selected_slots" id="selectedSlotsInput" value="">

    <!-- Left Column: Step 1 (Date), Step 2 (Court), Step 3 (Slots) -->
    <div class="lg:col-span-8 space-y-6">

      <!-- STEP 1: Date Selection -->
      <div class="glass-card p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-brand-800 text-white flex items-center justify-center text-xs font-bold">1</span>
            <h2 class="text-base font-bold text-slate-900">Choose Booking Date</h2>
          </div>
          <input type="date" id="datePicker" class="form-input text-xs w-auto py-1 px-3" value="<%= selectedDate %>" min="<%= minDate %>">
        </div>

        <!-- Quick 7-Day Pills -->
        <div class="grid grid-cols-3 sm:grid-cols-7 gap-2" id="quickDaysContainer">
          <% datePills.forEach(pill => { %>
            <button type="button" 
                    data-date="<%= pill.isoDate %>" 
                    class="quick-date-pill p-2.5 rounded-xl border text-center transition flex flex-col items-center gap-0.5 <%= pill.isoDate === selectedDate ? 'border-brand-800 bg-brand-800 text-white shadow-xs' : 'border-slate-200 bg-white text-slate-700 hover:border-brand-600 hover:bg-brand-50/50' %>">
              <span class="text-[10px] uppercase font-bold tracking-wider opacity-80"><%= pill.dayName %></span>
              <span class="text-base font-extrabold"><%= pill.dayNum %></span>
              <span class="text-[10px] opacity-80"><%= pill.monthName %></span>
            </button>
          <% }) %>
        </div>
      </div>

      <!-- STEP 2: Court Selection -->
      <div class="glass-card p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-6 h-6 rounded-full bg-brand-800 text-white flex items-center justify-center text-xs font-bold">2</span>
          <h2 class="text-base font-bold text-slate-900">Select Court</h2>
        </div>

        <% if (courts.length === 0) { %>
          <div class="p-8 text-center text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">
            <i data-lucide="alert-circle" class="w-8 h-8 mx-auto mb-2 text-slate-400"></i>
            <p class="text-sm font-semibold">No courts configured yet.</p>
            <p class="text-xs text-slate-500 mt-1">Please log in to the admin panel to add your facility's courts.</p>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% courts.forEach((court, idx) => { %>
              <div data-court-id="<%= court.id %>"
                   data-court-name="<%= court.name %>"
                   data-court-price="<%= court.price_per_hour %>"
                   class="court-card p-4 rounded-xl border transition cursor-pointer flex flex-col justify-between <%= (idx === 0) ? 'border-brand-800 bg-brand-50/40 ring-2 ring-brand-800/15' : 'border-slate-200 bg-white hover:border-brand-600 hover:bg-slate-50/50' %>">
                <div>
                  <% if (court.image_url) { %>
                    <img src="<%= court.image_url %>" alt="<%= court.name %>" class="w-full h-32 object-cover rounded-lg mb-3 border border-slate-200">
                  <% } else { %>
                    <div class="w-full h-24 bg-gradient-to-br from-slate-100 to-slate-200 rounded-lg mb-3 flex items-center justify-center text-slate-400 border border-slate-200">
                      <i data-lucide="image" class="w-6 h-6"></i>
                    </div>
                  <% } %>
                  <div class="flex items-center justify-between mb-1">
                    <h3 class="font-bold text-sm text-slate-900"><%= court.name %></h3>
                    <span class="text-xs font-extrabold text-brand-800"><%= formatCurrency(court.price_per_hour) %><span class="text-[10px] font-normal text-slate-500">/hr</span></span>
                  </div>
                  <p class="text-xs text-slate-500 line-clamp-2"><%= court.surface_type || 'Standard surface' %></p>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] font-semibold text-brand-700">
                  <span class="inline-flex items-center gap-1">
                    <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
                    Available for Booking
                  </span>
                  <span class="court-check-indicator <%= (idx === 0) ? '' : 'hidden' %> text-brand-800 font-bold">Selected</span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- STEP 3: Available Time Slots -->
      <div class="glass-card p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-brand-800 text-white flex items-center justify-center text-xs font-bold">3</span>
            <h2 class="text-base font-bold text-slate-900">Select Time Slots</h2>
          </div>
          <span class="text-xs text-slate-500 font-medium">Click to select 1 or more consecutive slots</span>
        </div>

        <div id="slotsLoading" class="hidden p-8 text-center text-slate-500">
          <div class="spinner border-brand-800 border-t-transparent mx-auto mb-2"></div>
          <span class="text-xs">Checking real-time slot availability...</span>
        </div>

        <div id="slotsGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          <!-- Populated dynamically via JS or SSR -->
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-500 pt-3 border-t border-slate-100">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-white border border-slate-300"></span>
            <span>Available</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-brand-800"></span>
            <span>Selected</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-slate-200 line-through"></span>
            <span>Reserved / Blocked</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Right Column: Booking Summary & Checkout Button (Sticky) -->
    <div class="lg:col-span-4 sticky top-24">
      <div class="glass-card p-6 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <h3 class="font-bold text-sm text-slate-900">Booking Summary</h3>
          <span class="text-[10px] font-bold text-brand-700 uppercase bg-brand-50 px-2 py-0.5 rounded-full border border-brand-100">Real-Time</span>
        </div>

        <div class="space-y-3 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-500">Court</span>
            <span id="summaryCourtName" class="font-bold text-slate-900"><%= courts.length > 0 ? courts[0].name : 'None' %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Date</span>
            <span id="summaryDate" class="font-bold text-slate-900"><%= formatDateDisplay(selectedDate) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Rate</span>
            <span id="summaryRate" class="font-bold text-slate-900"><%= courts.length > 0 ? formatCurrency(courts[0].price_per_hour) + '/hr' : '₱0.00' %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Selected Slots</span>
            <span id="summarySlotsCount" class="font-bold text-brand-800">0 slot(s) selected</span>
          </div>

          <div id="summarySlotsList" class="p-2.5 bg-slate-50 rounded-lg border border-slate-100 text-slate-600 text-[11px] font-mono-code min-h-[40px] flex items-center justify-center">
            No time slots chosen yet
          </div>
        </div>

        <!-- Total Price -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-700">Total Amount:</span>
          <span id="summaryTotalPrice" class="text-2xl font-extrabold text-brand-800">₱0.00</span>
        </div>

        <button type="submit" id="btnContinueCheckout" disabled class="btn-primary-green w-full py-3 text-sm font-bold shadow-sm">
          <span>Proceed to Payment</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>

        <p class="text-[11px] text-center text-slate-400">
          Payment is verified via GCash QR Code.
        </p>
      </div>
    </div>
  </form>

</div>

<script src="/js/booking.js"></script>
