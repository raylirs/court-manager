<div class="space-y-8 animate-fade-in">

  <!-- Hero Platform Banner -->
  <div class="glass-card p-6 sm:p-10 relative overflow-hidden">
    <div class="max-w-3xl relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-100 text-brand-800 text-xs font-bold mb-4">
        <i data-lucide="trophy" class="w-3.5 h-3.5 text-brand-600"></i>
        <span>Premier Sports Facilities & Court Booking Network</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
        Find & Reserve Sports Courts
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
        Select a partner facility below to check real-time court availability, choose your playing hours, and confirm your reservation with instant GCash payment.
      </p>

      <!-- Search Input -->
      <form action="/" method="GET" class="flex gap-2 max-w-lg">
        <div class="relative flex-1">
          <input type="text" name="q" value="<%= search || '' %>" placeholder="Search by venue name, location, or sport..." class="form-input text-xs" style="padding-left: 2.25rem;">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
        </div>
        <button type="submit" class="btn-primary-green px-5 text-xs font-bold shrink-0">Search</button>
      </form>
    </div>
  </div>

  <!-- Venue Directory List -->
  <div class="space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-slate-200">
      <h2 class="text-lg font-extrabold text-slate-900 tracking-tight">Partner Facilities & Arenas (<%= venues.length %>)</h2>
      <span class="text-xs text-slate-500 font-medium">Verified GCash Integration</span>
    </div>

    <% if (venues.length === 0) { %>
      <div class="glass-card p-12 text-center text-slate-400">
        <i data-lucide="building" class="w-10 h-10 mx-auto mb-2 text-slate-300"></i>
        <h3 class="text-sm font-bold text-slate-700">No facilities found</h3>
        <p class="text-xs text-slate-400 mt-1">Try a different search term or check back soon.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% venues.forEach(v => { %>
          <div class="glass-card glass-card-hover overflow-hidden flex flex-col justify-between">
            <div>
              <!-- Cover Image or Placeholder -->
              <% if (v.cover_image_url || v.logo_url) { %>
                <img src="<%= v.cover_image_url || v.logo_url %>" alt="<%= v.name %>" class="w-full h-44 object-cover border-b border-slate-100">
              <% } else { %>
                <div class="w-full h-36 bg-gradient-to-br from-brand-50 to-slate-100 flex items-center justify-center text-brand-800 border-b border-slate-100">
                  <i data-lucide="trophy" class="w-12 h-12 stroke-[1.5]"></i>
                </div>
              <% } %>

              <div class="p-5 space-y-2">
                <div class="flex items-center justify-between">
                  <h3 class="font-extrabold text-base text-slate-900"><%= v.name %></h3>
                  <span class="badge-confirmed text-[10px]"><%= (v.courts ? v.courts.length : 0) %> Courts</span>
                </div>

                <p class="text-xs text-slate-500 line-clamp-2"><%= v.description || 'Premier athletic facility equipped with tournament courts.' %></p>

                <div class="pt-2 space-y-1 text-xs text-slate-600">
                  <div class="flex items-center gap-1.5 text-slate-500">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-700 shrink-0"></i>
                    <span class="truncate"><%= v.address || 'Metropolitan Area' %></span>
                  </div>
                  <div class="flex items-center gap-1.5 text-slate-500">
                    <i data-lucide="clock" class="w-3.5 h-3.5 text-brand-700 shrink-0"></i>
                    <span><%= formatTime12(v.open_time) %> - <%= formatTime12(v.close_time) %></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Button -->
            <div class="p-4 bg-slate-50/80 border-t border-slate-100 flex items-center justify-between">
              <div>
                <% if (v.courts && v.courts.length > 0) { %>
                  <span class="text-[10px] text-slate-400 block font-semibold uppercase">Starting from</span>
                  <span class="font-extrabold text-brand-800 text-xs"><%= formatCurrency(Math.min(...v.courts.map(c => c.price_per_hour))) %><span class="text-[10px] text-slate-400 font-normal">/hr</span></span>
                <% } else { %>
                  <span class="text-xs text-slate-400 font-medium">Hours available</span>
                <% } %>
              </div>

              <a href="/v/<%= v.slug %>" class="btn-primary-green text-xs font-bold py-2 px-4 shadow-2xs">
                <span>Book Court</span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

</div>
