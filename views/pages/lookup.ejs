<div class="max-w-xl mx-auto py-8 animate-fade-in space-y-6">

  <div class="text-center">
    <div class="w-12 h-12 rounded-2xl bg-brand-50 border border-brand-200 text-brand-800 flex items-center justify-center mx-auto mb-3 shadow-xs">
      <i data-lucide="search" class="w-6 h-6"></i>
    </div>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Lookup Court Reservation</h1>
    <p class="text-xs text-slate-500 mt-1">Enter your Reference Code (e.g. CM-ABC12) or email address to view booking status.</p>
  </div>

  <div class="glass-card p-6">
    <form action="/lookup" method="GET" class="space-y-4">
      <div>
        <label class="form-label">Reference Code or Email Address</label>
        <div class="flex gap-2">
          <input type="text" name="q" value="<%= query || '' %>" required placeholder="e.g. CM-7XK9P or name@gmail.com" class="form-input font-mono-code text-sm">
          <button type="submit" class="btn-primary-green px-5 shrink-0">
            <i data-lucide="search" class="w-4 h-4"></i>
            <span>Search</span>
          </button>
        </div>
      </div>
    </form>
  </div>

  <% if (searched) { %>
    <% if (results && results.length > 0) { %>
      <div class="space-y-4">
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Found <%= results.length %> Reservation(s)</h2>

        <% results.forEach(res => { %>
          <div class="glass-card p-5 space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
              <span class="font-mono-code text-sm font-extrabold text-brand-800"><%= res.reference_code %></span>
              <% if (res.payment_status === 'confirmed') { %>
                <span class="badge-confirmed"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Confirmed</span>
              <% } else if (res.payment_status === 'pending_payment') { %>
                <span class="badge-pending"><i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending Verification</span>
              <% } else { %>
                <span class="badge-cancelled"><i data-lucide="x-circle" class="w-3.5 h-3.5"></i> <%= res.payment_status %></span>
              <% } %>
            </div>

            <div class="grid grid-cols-2 gap-2 text-xs">
              <div>
                <span class="text-slate-400 block text-[11px]">Court</span>
                <span class="font-bold text-slate-800"><%= res.court ? res.court.name : 'Court #' + res.court_id %></span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Date</span>
                <span class="font-bold text-slate-800"><%= formatDateDisplay(res.booking_date) %></span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Time</span>
                <span class="font-bold text-slate-800 font-mono-code"><%= formatTime12(res.start_time) %> - <%= formatTime12(res.end_time) %></span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Total Price</span>
                <span class="font-bold text-brand-800"><%= formatCurrency(res.total_price) %></span>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-100 text-[11px] text-slate-500 flex justify-between">
              <span>Booked by: <strong><%= res.player_name %></strong></span>
              <span>GCash Ref: <strong class="font-mono-code"><%= res.gcash_reference_no || 'N/A' %></strong></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">
        <i data-lucide="file-question" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
        <p class="text-sm font-semibold text-slate-700">No reservations found.</p>
        <p class="text-xs text-slate-400 mt-1">Please verify the reference code or email address and try again.</p>
      </div>
    <% } %>
  <% } %>

</div>
