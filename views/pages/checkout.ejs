<div class="max-w-4xl mx-auto space-y-6 animate-fade-in">

  <!-- Header Breadcrumb -->
  <div class="flex items-center justify-between pb-4 border-b border-slate-200">
    <div>
      <a href="/v/<%= venue.slug %>" class="text-xs font-semibold text-brand-800 hover:text-brand-900 inline-flex items-center gap-1 mb-1">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        <span>Back to <%= venue.name %></span>
      </a>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Complete Court Reservation</h1>
      <p class="text-xs text-slate-500">Provide player contact details and complete GCash payment to <%= venue.name %>.</p>
    </div>
  </div>

  <form action="/v/<%= venue.slug %>/confirm-booking" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <input type="hidden" name="court_id" value="<%= court.id %>">
    <input type="hidden" name="booking_date" value="<%= bookingDate %>">
    <input type="hidden" name="selected_slots" value="<%= selectedSlotsRaw %>">

    <!-- Left Column: Player Details & Notes -->
    <div class="lg:col-span-7 space-y-6">

      <!-- Booking Summary Box -->
      <div class="glass-card p-5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Reservation Details</h3>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-slate-100">
            <span class="text-slate-500">Venue / Arena:</span>
            <span class="font-bold text-slate-900"><%= venue.name %></span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-100">
            <span class="text-slate-500">Facility Court:</span>
            <span class="font-bold text-slate-900"><%= court.name %></span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-100">
            <span class="text-slate-500">Date:</span>
            <span class="font-bold text-slate-900"><%= formatDateDisplay(bookingDate) %></span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-100">
            <span class="text-slate-500">Time Slot(s):</span>
            <span class="font-bold text-slate-900 font-mono-code"><%= slotLabels.join(', ') %></span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-100">
            <span class="text-slate-500">Duration:</span>
            <span class="font-bold text-slate-900"><%= totalHours %> hour(s)</span>
          </div>
          <div class="flex justify-between pt-2 text-sm font-extrabold">
            <span class="text-slate-800">Total Due:</span>
            <span class="text-brand-800 text-lg"><%= formatCurrency(totalPrice) %></span>
          </div>
        </div>
      </div>

      <!-- Player Info Card -->
      <div class="glass-card p-6 space-y-4">
        <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="user" class="w-4 h-4 text-brand-700"></i>
          <span>Player Contact Information</span>
        </h3>

        <div>
          <label class="form-label">Full Name <span class="text-rose-500">*</span></label>
          <input type="text" name="player_name" required placeholder="e.g. Maria Santos" class="form-input">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="form-label">Mobile Number (GCash contact) <span class="text-rose-500">*</span></label>
            <input type="tel" name="player_phone" required placeholder="0917-xxx-xxxx" class="form-input font-mono-code">
          </div>
          <div>
            <label class="form-label">Email Address (for receipt) <span class="text-rose-500">*</span></label>
            <input type="email" name="player_email" required placeholder="maria@gmail.com" class="form-input">
          </div>
        </div>

        <div>
          <label class="form-label">Special Requests / Notes (Optional)</label>
          <textarea name="notes" rows="2" placeholder="e.g. Requesting extra balls or paddle rental" class="form-input"></textarea>
        </div>
      </div>

    </div>

    <!-- Right Column: GCash Payment Verification -->
    <div class="lg:col-span-5 space-y-6">

      <div class="glass-card p-6 space-y-5 border-2 border-brand-800/20">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-xs">
              G
            </div>
            <div>
              <h3 class="text-xs font-bold text-slate-900">Official <%= venue.name %> GCash</h3>
              <p class="text-[10px] text-slate-500">Scan QR to pay directly</p>
            </div>
          </div>
          <span class="text-xs font-extrabold text-blue-600 font-mono-code">GCash</span>
        </div>

        <!-- QR Display -->
        <div class="text-center p-4 bg-slate-50 rounded-xl border border-slate-200">
          <% if (venue.gcash_qr_image) { %>
            <img src="<%= venue.gcash_qr_image %>" alt="GCash QR Code" class="w-48 h-48 object-contain mx-auto rounded-lg shadow-2xs border border-slate-200 mb-2">
          <% } else { %>
            <div class="w-48 h-48 bg-white border border-dashed border-slate-300 rounded-lg mx-auto flex flex-col items-center justify-center text-slate-400 mb-2">
              <i data-lucide="qr-code" class="w-12 h-12 mb-1 text-slate-300"></i>
              <span class="text-[11px] font-semibold">QR Code Setup In Progress</span>
            </div>
          <% } %>

          <div class="space-y-0.5 text-xs">
            <span class="text-slate-500 text-[11px] block">Merchant Account Name:</span>
            <span class="font-bold text-slate-900 block"><%= venue.gcash_account_name || venue.name %></span>
            <% if (venue.gcash_account_number) { %>
              <span class="font-mono-code text-slate-600 text-[11px] block font-semibold"><%= venue.gcash_account_number %></span>
            <% } %>
          </div>
        </div>

        <!-- Instructions -->
        <div class="space-y-1.5 text-[11px] text-slate-600 bg-emerald-50/60 p-3 rounded-lg border border-emerald-100">
          <div class="font-bold text-emerald-900 mb-1 flex items-center gap-1">
            <i data-lucide="info" class="w-3.5 h-3.5"></i>
            How to pay <%= venue.name %>:
          </div>
          <p>1. Open your GCash app and tap <strong>Scan QR</strong>.</p>
          <p>2. Send the exact amount: <strong class="text-slate-900"><%= formatCurrency(totalPrice) %></strong>.</p>
          <p>3. Enter your <strong>GCash Reference No.</strong> below.</p>
        </div>

        <!-- Payment Inputs -->
        <div class="space-y-3">
          <div>
            <label class="form-label">GCash Reference Number <span class="text-rose-500">*</span></label>
            <input type="text" name="gcash_reference_no" required placeholder="e.g. 1029384756182" class="form-input font-mono-code text-xs">
          </div>

          <div>
            <label class="form-label">Upload Payment Screenshot / Proof (Optional)</label>
            <input type="file" name="payment_proof" accept="image/*" class="form-input text-xs py-1.5">
          </div>
        </div>

        <button type="submit" id="btnSubmitOrder" class="btn-primary-green w-full py-3 text-sm font-bold shadow-sm">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
          <span>Confirm & Submit Booking</span>
        </button>

        <p class="text-[10px] text-center text-slate-400">
          Your booking will be reserved instantly with <%= venue.name %>. You will receive an email confirmation.
        </p>
      </div>

    </div>
  </form>

</div>
