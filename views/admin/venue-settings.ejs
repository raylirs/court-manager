<div class="max-w-3xl mx-auto space-y-6 animate-fade-in">

  <div class="pb-4 border-b border-slate-200">
    <h2 class="text-xl font-extrabold text-slate-900 tracking-tight"><%= currentVenue ? currentVenue.name : 'Facility' %> Profile & Operating Hours</h2>
    <p class="text-xs text-slate-500">Configure daily opening and closing hours, slot intervals, address, and venue information.</p>
  </div>

  <div class="glass-card p-6 sm:p-8">
    <form action="/admin/venue-settings" method="POST" class="space-y-6">

      <!-- Facility Identity -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-1.5">
          <i data-lucide="building" class="w-3.5 h-3.5"></i>
          Facility Details
        </h3>
        <div class="space-y-4">
          <div>
            <label class="form-label">Venue / Club Name <span class="text-rose-500">*</span></label>
            <input type="text" name="name" required value="<%= currentVenue ? currentVenue.name : '' %>" placeholder="e.g. The Playground Pickleball Club" class="form-input">
          </div>

          <div>
            <label class="form-label">Facility Description</label>
            <textarea name="description" rows="2" placeholder="e.g. Premier indoor and outdoor pickleball courts equipped with professional acrylic surfaces." class="form-input"><%= currentVenue ? currentVenue.description : '' %></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="form-label">Physical Address</label>
              <input type="text" name="address" value="<%= currentVenue ? currentVenue.address : '' %>" placeholder="e.g. 123 Sports Complex Way, Taguig City" class="form-input">
            </div>
            <div>
              <label class="form-label">Contact Phone / Mobile</label>
              <input type="text" name="contact_phone" value="<%= currentVenue ? currentVenue.contact_phone : '' %>" placeholder="e.g. 0917-xxx-xxxx" class="form-input font-mono-code">
            </div>
          </div>

          <div>
            <label class="form-label">Contact Email</label>
            <input type="email" name="contact_email" value="<%= currentVenue ? currentVenue.contact_email : '' %>" placeholder="contact@venue.com" class="form-input">
          </div>
        </div>
      </div>

      <!-- Schedule & Slot Generator -->
      <div class="pt-4 border-t border-slate-100">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-1.5">
          <i data-lucide="clock" class="w-3.5 h-3.5"></i>
          Daily Schedule & Time-Slot Configuration
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="form-label">Daily Open Time <span class="text-rose-500">*</span></label>
            <input type="time" name="open_time" required value="<%= currentVenue ? currentVenue.open_time : '06:00' %>" class="form-input font-mono-code text-xs">
            <span class="text-[10px] text-slate-400 mt-1 block">Earliest booking slot start</span>
          </div>

          <div>
            <label class="form-label">Daily Close Time <span class="text-rose-500">*</span></label>
            <input type="time" name="close_time" required value="<%= currentVenue ? currentVenue.close_time : '22:00' %>" class="form-input font-mono-code text-xs">
            <span class="text-[10px] text-slate-400 mt-1 block">Latest booking slot finish</span>
          </div>

          <div>
            <label class="form-label">Slot Duration <span class="text-rose-500">*</span></label>
            <select name="slot_duration" class="form-select text-xs">
              <option value="60" <%= (currentVenue && currentVenue.slot_duration === 60) ? 'selected' : '' %>>60 Minutes (1 Hour)</option>
              <option value="90" <%= (currentVenue && currentVenue.slot_duration === 90) ? 'selected' : '' %>>90 Minutes (1.5 Hours)</option>
              <option value="120" <%= (currentVenue && currentVenue.slot_duration === 120) ? 'selected' : '' %>>120 Minutes (2 Hours)</option>
            </select>
            <span class="text-[10px] text-slate-400 mt-1 block">Incremental slot block size</span>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 flex justify-end">
        <button type="submit" class="btn-primary-green py-2.5 px-6 text-xs font-bold shadow-sm">
          <i data-lucide="check" class="w-4 h-4"></i>
          <span>Save Venue Profile</span>
        </button>
      </div>

    </form>
  </div>

</div>
