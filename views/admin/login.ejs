<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Login | <%= venueName || 'Court Manager' %></title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Custom CSS matching Forticlient -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex items-center justify-center min-h-screen p-4 antialiased text-slate-800">

  <div class="w-full max-w-md animate-pop-in">
    <!-- Brand Title -->
    <div class="text-center mb-6">
      <div class="w-12 h-12 rounded-2xl bg-brand-800 text-white flex items-center justify-center mx-auto mb-3 shadow-md">
        <i data-lucide="shield-check" class="w-7 h-7"></i>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight"><%= venueName || 'Court Manager' %></h1>
      <p class="text-xs text-slate-500 mt-1 font-medium">Administrator & Facility Staff Access</p>
    </div>

    <!-- Login Card -->
    <div class="glass-card p-8 border border-slate-200/90 shadow-lg">

      <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-3.5 py-2.5 rounded-xl flex items-center gap-2 text-xs mb-4">
          <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600 shrink-0"></i>
          <span><%= error_msg %></span>
        </div>
      <% } %>

      <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-3.5 py-2.5 rounded-xl flex items-center gap-2 text-xs mb-4">
          <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 shrink-0"></i>
          <span><%= success_msg %></span>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-4">
        <div>
          <label class="form-label">Email Address</label>
          <div class="relative">
            <input type="email" name="email" required placeholder="admin@courtmanager.com" class="form-input" style="padding-left: 2.25rem;">
            <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
          </div>
        </div>

        <div>
          <label class="form-label">Password</label>
          <div class="relative">
            <input type="password" name="password" required placeholder="••••••••" class="form-input" style="padding-left: 2.25rem;">
            <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
          </div>
        </div>

        <button type="submit" class="btn-primary-green w-full py-2.5 text-xs font-bold shadow-sm mt-2">
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span>Sign In to Admin Console</span>
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
        <a href="/" class="hover:text-brand-800 inline-flex items-center gap-1">
          <i data-lucide="arrow-left" class="w-3 h-3"></i>
          <span>Back to Court Booking</span>
        </a>
        <span>Protected Portal</span>
      </div>
    </div>
  </div>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>
