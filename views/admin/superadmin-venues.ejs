<div class="space-y-6 animate-fade-in">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Partner Venues & Facility Clients</h2>
      <p class="text-xs text-slate-500">Create and manage client sports venues. Each client gets their own dedicated public booking link, admin account, and courts.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Add Venue Form (5 cols) -->
    <div class="lg:col-span-5 glass-card p-6 space-y-4">
      <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-100">
        <i data-lucide="plus-circle" class="w-4 h-4 text-brand-700"></i>
        <span>Onboard New Client Venue</span>
      </h3>

      <form action="/admin/venues" method="POST" enctype="multipart/form-data" class="space-y-4 text-xs">
        <div>
          <label class="form-label">Venue / Club Name <span class="text-rose-500">*</span></label>
          <input type="text" name="name" required placeholder="e.g. Metro Smash Arena" class="form-input">
        </div>

        <div>
          <label class="form-label">URL Slug (e.g., /v/metro-smash)</label>
          <input type="text" name="slug" placeholder="e.g. metro-smash" class="form-input font-mono-code">
          <p class="text-[10px] text-slate-400 mt-1">Leave blank to auto-generate from name.</p>
        </div>

        <div>
          <label class="form-label">Physical Address</label>
          <input type="text" name="address" placeholder="e.g. 88 Ortigas Ave, Pasig City" class="form-input">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="form-label">Contact Phone</label>
            <input type="tel" name="contact_phone" placeholder="0917-xxx-xxxx" class="form-input font-mono-code">
          </div>
          <div>
            <label class="form-label">Contact Email</label>
            <input type="email" name="contact_email" placeholder="club@gmail.com" class="form-input">
          </div>
        </div>

        <div>
          <label class="form-label">Venue Logo (Optional)</label>
          <input type="file" name="logo" accept="image/*" class="form-input py-1.5">
        </div>

        <div class="pt-2 border-t border-slate-100">
          <span class="font-bold text-slate-800 block mb-2">Initial Client Admin Login</span>
          <div class="space-y-2">
            <div>
              <label class="form-label">Admin Name</label>
              <input type="text" name="admin_name" placeholder="Facility Manager" class="form-input">
            </div>
            <div>
              <label class="form-label">Admin Login Email <span class="text-rose-500">*</span></label>
              <input type="email" name="admin_email" required placeholder="client@domain.com" class="form-input">
            </div>
            <div>
              <label class="form-label">Admin Initial Password <span class="text-rose-500">*</span></label>
              <input type="password" name="admin_password" required placeholder="••••••••" class="form-input font-mono-code">
            </div>
          </div>
        </div>

        <button type="submit" class="btn-primary-green w-full py-2.5 text-xs font-bold shadow-sm">
          <i data-lucide="check-circle" class="w-4 h-4"></i>
          <span>Create Venue & Admin Account</span>
        </button>
      </form>
    </div>

    <!-- Active Venues List (7 cols) -->
    <div class="lg:col-span-7 space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Registered Venues (<%= venues.length %>)</h3>

      <% if (venues.length === 0) { %>
        <div class="glass-card p-8 text-center text-slate-400 text-xs">
          No partner venues onboarded yet.
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% venues.forEach(v => { %>
            <div class="glass-card p-5 space-y-3">
              <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-brand-800 text-white flex items-center justify-center font-bold text-xs">
                    <i data-lucide="trophy" class="w-4 h-4"></i>
                  </div>
                  <div>
                    <h4 class="font-extrabold text-sm text-slate-900 leading-tight"><%= v.name %></h4>
                    <span class="text-[11px] text-brand-800 font-mono-code">/v/<%= v.slug %></span>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <a href="/v/<%= v.slug %>" target="_blank" class="btn-secondary-white py-1 px-2.5 text-[11px]" title="Visit Public Page">
                    <i data-lucide="external-link" class="w-3 h-3 text-slate-500"></i>
                    <span>Public View</span>
                  </a>
                  <a href="/admin?switch_venue_id=<%= v.id %>" class="btn-primary-green py-1 px-2.5 text-[11px]">
                    <i data-lucide="sliders" class="w-3 h-3"></i>
                    <span>Manage</span>
                  </a>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 text-xs">
                <div class="p-2 bg-slate-50 rounded-lg border border-slate-100">
                  <span class="text-[10px] text-slate-400 block uppercase font-semibold">Courts</span>
                  <span class="font-bold text-slate-800 text-sm"><%= v.courts ? v.courts.length : 0 %></span>
                </div>
                <div class="p-2 bg-slate-50 rounded-lg border border-slate-100">
                  <span class="text-[10px] text-slate-400 block uppercase font-semibold">Bookings</span>
                  <span class="font-bold text-slate-800 text-sm"><%= v.reservations ? v.reservations.length : 0 %></span>
                </div>
                <div class="p-2 bg-slate-50 rounded-lg border border-slate-100">
                  <span class="text-[10px] text-slate-400 block uppercase font-semibold">Managers</span>
                  <span class="font-bold text-slate-800 text-sm"><%= v.managers ? v.managers.length : 0 %></span>
                </div>
              </div>

              <div class="text-[11px] text-slate-500 flex items-center justify-between pt-1">
                <span class="truncate"><i data-lucide="map-pin" class="w-3 h-3 inline text-slate-400"></i> <%= v.address || 'No address set' %></span>
                <span class="font-mono-code text-slate-400"><%= formatTime12(v.open_time) %> - <%= formatTime12(v.close_time) %></span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

</div>
