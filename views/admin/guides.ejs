<div class="max-w-5xl mx-auto space-y-8 animate-fade-in">

  <!-- Header -->
  <div class="pb-4 border-b border-slate-200">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-100 text-brand-800 text-xs font-bold mb-2">
      <i data-lucide="book-open" class="w-3.5 h-3.5 text-brand-700"></i>
      <span>Official Administrator Documentation</span>
    </div>
    <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Integration & Setup Guides</h2>
    <p class="text-xs sm:text-sm text-slate-500">Step-by-step instructions for configuring automated booking receipts via Gmail SMTP and instant Facebook Messenger push alerts.</p>
  </div>

  <!-- Navigation Anchor Pills -->
  <div class="flex items-center gap-3">
    <a href="#gmail-guide" class="btn-secondary-white py-2 px-4 text-xs font-bold">
      <i data-lucide="mail" class="w-4 h-4 text-rose-500"></i>
      <span>1. Gmail SMTP Setup Guide</span>
    </a>
    <a href="#facebook-guide" class="btn-secondary-white py-2 px-4 text-xs font-bold">
      <i data-lucide="message-circle" class="w-4 h-4 text-blue-600"></i>
      <span>2. Meta Messenger Setup Guide</span>
    </a>
  </div>

  <!-- ========================================== -->
  <!-- GUIDE 1: GMAIL SMTP SETUP -->
  <!-- ========================================== -->
  <div id="gmail-guide" class="glass-card p-6 sm:p-8 space-y-6 border-l-4 border-l-rose-500">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-sm">
          <i data-lucide="mail" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 class="text-base font-extrabold text-slate-900">How to Setup Gmail SMTP for Automated Receipts</h3>
          <p class="text-xs text-slate-500">Send player confirmation emails and admin alerts directly from your Google Account.</p>
        </div>
      </div>
      <a href="/admin/email" class="btn-primary-green py-1.5 px-3 text-xs font-bold">
        <span>Go to Email Settings</span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="space-y-6 text-xs text-slate-700 leading-relaxed">

      <!-- Step 1 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">1</div>
        <div class="space-y-1.5 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Turn on 2-Step Verification in Google</h4>
          <p>Google requires 2-Step Verification before allowing apps to send mail via SMTP.</p>
          <p>Go to your <a href="https://myaccount.google.com/security" target="_blank" class="text-brand-800 font-bold underline inline-flex items-center gap-1">Google Account Security <i data-lucide="external-link" class="w-3 h-3"></i></a> page and ensure <strong>2-Step Verification</strong> is switched <strong>ON</strong>.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">2</div>
        <div class="space-y-1.5 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Generate a 16-Character "App Password"</h4>
          <p>Do <strong>NOT</strong> use your personal Google account password. Google provides dedicated app passwords for applications:</p>
          <ol class="list-decimal pl-4 space-y-1 mt-1 text-slate-600">
            <li>Visit the <a href="https://myaccount.google.com/apppasswords" target="_blank" class="text-brand-800 font-bold underline inline-flex items-center gap-1">Google App Passwords Page <i data-lucide="external-link" class="w-3 h-3"></i></a>.</li>
            <li>In the <strong>App name</strong> box, type <code>Court Manager</code>.</li>
            <li>Click <strong>Create</strong>.</li>
            <li>Google will show a yellow box with a <strong>16-letter code</strong> (e.g., <code>abcd efgh ijkl mnop</code>).</li>
            <li>Copy this 16-character password (spaces don't matter).</li>
          </ol>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">3</div>
        <div class="space-y-2 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Enter Credentials in Court Manager</h4>
          <p>Navigate to your <a href="/admin/email" class="text-brand-800 font-bold underline">Email & SMTP Hub</a> and fill in:</p>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left bg-slate-50 border border-slate-200 rounded-xl overflow-hidden font-mono-code text-[11px]">
              <thead class="bg-slate-100 text-slate-700">
                <tr><th class="p-2.5">Field</th><th class="p-2.5">Value to Enter</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-200 text-slate-800">
                <tr><td class="p-2.5 font-bold">SMTP Host</td><td class="p-2.5"><code>smtp.gmail.com</code></td></tr>
                <tr><td class="p-2.5 font-bold">SMTP Port</td><td class="p-2.5"><code>465</code></td></tr>
                <tr><td class="p-2.5 font-bold">SMTP Username</td><td class="p-2.5"><code>your.facility@gmail.com</code></td></tr>
                <tr><td class="p-2.5 font-bold">SMTP Password</td><td class="p-2.5"><code>abcd efgh ijkl mnop</code> <em>(Your 16-letter App Password)</em></td></tr>
                <tr><td class="p-2.5 font-bold">Sender Display Name</td><td class="p-2.5"><code><%= currentVenue ? currentVenue.name : 'Your Facility Name' %></code></td></tr>
                <tr><td class="p-2.5 font-bold">Admin Alert Recipient</td><td class="p-2.5"><code>your.email@gmail.com</code> <em>(Where new booking alerts are sent)</em></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">4</div>
        <div class="space-y-1.5 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Verify with Live Delivery Test</h4>
          <p>Click the <strong>"Save Email & SMTP Settings"</strong> button, then on the right panel, type your personal email address into <strong>"Send Test Email To"</strong> and click <strong>"Send Verification Email"</strong>.</p>
          <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-800 font-medium">
            ✅ If successful, you will immediately receive a green test ping email in your inbox!
          </div>
        </div>
      </div>

    </div>
  </div>


  <!-- ========================================== -->
  <!-- GUIDE 2: FACEBOOK & META MESSENGER SETUP -->
  <!-- ========================================== -->
  <div id="facebook-guide" class="glass-card p-6 sm:p-8 space-y-6 border-l-4 border-l-blue-600">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">
          <i data-lucide="message-circle" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 class="text-base font-extrabold text-slate-900">How to Setup Meta Messenger for Instant Push Alerts</h3>
          <p class="text-xs text-slate-500">Receive instant push notifications on your phone whenever a player reserves a court.</p>
        </div>
      </div>
      <a href="/admin/messenger" class="btn-primary-green py-1.5 px-3 text-xs font-bold">
        <span>Go to Messenger Settings</span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="space-y-6 text-xs text-slate-700 leading-relaxed">

      <!-- Step 1 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">1</div>
        <div class="space-y-1.5 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Have a Facebook Page for Your Venue</h4>
          <p>Create or use an existing Facebook Business Page for your court facility (e.g., <em>The Playground Pickleball</em>). You must be an Administrator of this Page.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">2</div>
        <div class="space-y-1.5 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Create a Meta App</h4>
          <ol class="list-decimal pl-4 space-y-1 mt-1 text-slate-600">
            <li>Go to <a href="https://developers.facebook.com/apps" target="_blank" class="text-blue-600 font-bold underline inline-flex items-center gap-1">Meta for Developers <i data-lucide="external-link" class="w-3 h-3"></i></a> and click <strong>Create App</strong>.</li>
            <li>Select <strong>Other</strong> > <strong>Business</strong> as the app type.</li>
            <li>Give your app a display name (e.g. <code>Court Manager Alerts</code>) and click <strong>Create App</strong>.</li>
            <li>On the App Dashboard, find <strong>Messenger</strong> and click <strong>Set Up</strong>.</li>
          </ol>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">3</div>
        <div class="space-y-2 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Generate a Page Access Token</h4>
          <p>In your Meta App Dashboard under <strong>Messenger > App settings</strong>:</p>
          <ol class="list-decimal pl-4 space-y-1 text-slate-600">
            <li>Scroll down to <strong>Access Tokens</strong>.</li>
            <li>Click <strong>Add or remove Pages</strong> and select your venue's Facebook Page.</li>
            <li>Click <strong>Generate Token</strong> next to your Page name.</li>
            <li>Check the box to understand and copy the generated token (starts with <code>EAAB...</code>).</li>
          </ol>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">4</div>
        <div class="space-y-2 flex-1">
          <h4 class="font-bold text-sm text-slate-900">How to Find Your Admin Profile PSID (Page-Scoped ID)</h4>
          <p>Meta requires a Page-Scoped ID (PSID) to send notifications directly to your Facebook Messenger account:</p>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-slate-700 space-y-1.5 font-sans">
            <p><strong>A.</strong> From your personal Facebook profile, open Messenger and send a quick message like <code>"hi"</code> or <code>"test"</code> to your venue's Facebook Page.</p>
            <p><strong>B.</strong> Go to the <a href="https://developers.facebook.com/tools/explorer" target="_blank" class="text-blue-600 font-bold underline inline-flex items-center gap-1">Meta Graph API Explorer <i data-lucide="external-link" class="w-3 h-3"></i></a>.</p>
            <p><strong>C.</strong> In the query bar at the top, select your Page from the User or Page dropdown, and paste:
              <br><code class="font-mono text-brand-800 font-bold bg-white px-2 py-0.5 rounded border border-slate-200 mt-1 inline-block">me/conversations?fields=participants</code>
            </p>
            <p><strong>D.</strong> Click <strong>Submit</strong>. You will see JSON containing your name and an <code>id</code> (e.g. <code>"id": "847291048592019"</code>).</p>
            <p><strong>E.</strong> Copy that number — that is your <strong>Admin PSID</strong>!</p>
          </div>
        </div>
      </div>

      <!-- Step 5 -->
      <div class="flex gap-4">
        <div class="w-7 h-7 rounded-full bg-brand-800 text-white font-bold flex items-center justify-center shrink-0 text-xs">5</div>
        <div class="space-y-1.5 flex-1">
          <h4 class="font-bold text-sm text-slate-900">Paste and Test in Court Manager</h4>
          <p>Go to your <a href="/admin/messenger" class="text-brand-800 font-bold underline">Meta Messenger Hub</a>:</p>
          <ul class="list-disc pl-4 space-y-1 text-slate-600">
            <li>Toggle <strong>Messenger Push Alerts</strong> to <strong>ON</strong>.</li>
            <li>Paste your <strong>Facebook Page Access Token</strong> (starts with <code>EAAB...</code>).</li>
            <li>Paste your <strong>Facebook Page ID</strong>.</li>
            <li>Paste your <strong>Admin PSID</strong> into the recipients field.</li>
            <li>Click <strong>Save Facebook Messenger Settings</strong>.</li>
            <li>On the right side, click <strong>"Send Test Messenger Ping"</strong>!</li>
          </ul>
          <div class="p-3 bg-blue-50 rounded-xl border border-blue-200 text-blue-900 font-medium">
            🔔 Your phone will instantly ding with a test booking notification from your Facebook Page!
          </div>
        </div>
      </div>

    </div>
  </div>

</div>
