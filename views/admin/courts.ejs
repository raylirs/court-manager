<div class="space-y-6 animate-fade-in">

  <!-- Header with Add Court Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Courts & Pricing Management</h2>
      <p class="text-xs text-slate-500">Configure your facility courts, upload pictures, set hourly rates, and toggle availability.</p>
    </div>
    <a href="/admin/courts/new" class="btn-primary-green text-xs font-bold py-2.5 px-4 shadow-sm">
      <i data-lucide="plus-circle" class="w-4 h-4"></i>
      <span>Add New Court</span>
    </a>
  </div>

  <% if (courts.length === 0) { %>
    <div class="glass-card p-12 text-center text-slate-400">
      <i data-lucide="layout-grid" class="w-12 h-12 mx-auto mb-3 text-slate-300"></i>
      <h3 class="text-base font-bold text-slate-700">No courts added yet</h3>
      <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1 mb-4">Add your first court to start accepting player reservations.</p>
      <a href="/admin/courts/new" class="btn-primary-green text-xs font-bold py-2 px-4">Create Court</a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% courts.forEach(court => { %>
        <div class="glass-card overflow-hidden flex flex-col justify-between border border-slate-200/90 shadow-2xs">
          <div>
            <!-- Court Image -->
            <% if (court.image_url) { %>
              <div class="relative h-44 bg-slate-100 overflow-hidden border-b border-slate-100">
                <img src="<%= court.image_url %>" alt="<%= court.name %>" class="w-full h-full object-cover">
                <div class="absolute top-3 right-3">
                  <% if (court.is_active) { %>
                    <span class="badge-confirmed text-[10px] shadow-sm"><i data-lucide="check-circle" class="w-3 h-3"></i> Active</span>
                  <% } else { %>
                    <span class="badge-cancelled text-[10px] shadow-sm"><i data-lucide="pause-circle" class="w-3 h-3"></i> Inactive</span>
                  <% } %>
                </div>
              </div>
            <% } else { %>
              <div class="h-32 bg-slate-100 flex items-center justify-center text-slate-400 border-b border-slate-100 relative">
                <i data-lucide="image" class="w-8 h-8 text-slate-300"></i>
                <div class="absolute top-3 right-3">
                  <% if (court.is_active) { %>
                    <span class="badge-confirmed text-[10px] shadow-sm">Active</span>
                  <% } else { %>
                    <span class="badge-cancelled text-[10px] shadow-sm">Inactive</span>
                  <% } %>
                </div>
              </div>
            <% } %>

            <!-- Details -->
            <div class="p-5 space-y-2">
              <div class="flex items-center justify-between">
                <h3 class="font-extrabold text-base text-slate-900"><%= court.name %></h3>
                <span class="font-bold text-sm text-brand-800"><%= formatCurrency(court.price_per_hour) %><span class="text-[10px] text-slate-400 font-normal">/hr</span></span>
              </div>
              <p class="text-xs text-slate-500 font-medium"><%= court.surface_type || 'Standard Court' %></p>
              <% if (court.description) { %>
                <p class="text-xs text-slate-600 line-clamp-2 pt-1"><%= court.description %></p>
              <% } %>
            </div>
          </div>

          <!-- Card Actions -->
          <div class="p-4 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between text-xs">
            <form action="/admin/courts/<%= court.id %>/toggle" method="POST">
              <button type="submit" class="text-xs font-semibold <%= court.is_active ? 'text-amber-700 hover:text-amber-800' : 'text-emerald-700 hover:text-emerald-800' %>">
                <%= court.is_active ? 'Pause Bookings' : 'Activate Court' %>
              </button>
            </form>

            <div class="flex items-center gap-2">
              <a href="/admin/courts/<%= court.id %>/edit" class="btn-secondary-white py-1.5 px-3 text-xs">
                <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                <span>Edit</span>
              </a>
              <form action="/admin/courts/<%= court.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to remove this court?');">
                <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 transition" title="Delete Court">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>
