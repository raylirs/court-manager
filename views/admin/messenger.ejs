<div class="max-w-4xl mx-auto space-y-6 animate-fade-in">

  <div class="pb-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Meta Facebook Messenger Notification Hub</h2>
      <p class="text-xs text-slate-500">Connect Facebook Page alerts for <strong><%= currentVenue ? currentVenue.name : 'this venue' %></strong>.</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="https://developers.facebook.com/apps" target="_blank" class="btn-secondary-white py-1.5 px-3 text-xs">
        <i data-lucide="external-link" class="w-3.5 h-3.5 text-slate-400"></i>
        <span>Meta Dashboard</span>
      </a>
      <a href="https://developers.facebook.com/tools/explorer" target="_blank" class="btn-secondary-white py-1.5 px-3 text-xs">
        <i data-lucide="terminal" class="w-3.5 h-3.5 text-slate-400"></i>
        <span>Graph API Explorer</span>
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Credentials Form (7 cols) -->
    <div class="lg:col-span-7 glass-card p-6 sm:p-8 space-y-5">
      <form action="/admin/messenger" method="POST" class="space-y-4">

        <div class="flex items-center justify-between p-3 bg-brand-50 rounded-xl border border-brand-100">
          <div>
            <span class="text-xs font-bold text-brand-900 block">Messenger Push Alerts</span>
            <span class="text-[11px] text-brand-700 block">Send instant Messenger booking alert to <%= currentVenue ? currentVenue.name : 'venue' %> managers</span>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="fb_enabled" value="true" <%= (currentVenue && currentVenue.fb_enabled) ? 'checked' : '' %> class="sr-only peer">
            <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-800"></div>
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="form-label">Facebook App ID</label>
            <input type="text" name="fb_app_id" value="<%= currentVenue ? currentVenue.fb_app_id || '' : '' %>" placeholder="e.g. 1573381463838687" class="form-input font-mono-code text-xs">
          </div>
          <div>
            <label class="form-label">Facebook App Secret</label>
            <input type="password" name="fb_app_secret" value="<%= currentVenue ? currentVenue.fb_app_secret || '' : '' %>" placeholder="••••••••••••••••" class="form-input font-mono-code text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="form-label">Facebook Page ID</label>
            <input type="text" name="fb_page_id" value="<%= currentVenue ? currentVenue.fb_page_id || '' : '' %>" placeholder="e.g. 102938475618293" class="form-input font-mono-code text-xs">
          </div>
          <div>
            <label class="form-label">Facebook Page Name</label>
            <input type="text" name="fb_page_name" value="<%= currentVenue ? currentVenue.fb_page_name || '' : '' %>" placeholder="e.g. The Playground Pickleball" class="form-input text-xs">
          </div>
        </div>

        <div>
          <label class="form-label">Permanent Page Access Token</label>
          <textarea name="fb_page_token" rows="3" placeholder="EAAB... (Paste Page Access Token from Graph API Explorer)" class="form-input font-mono-code text-xs"><%= currentVenue ? currentVenue.fb_page_token || '' : '' %></textarea>
        </div>

        <div>
          <label class="form-label">Admin Profile PSID(s) (Comma-separated)</label>
          <input type="text" name="fb_admin_psids" value="<%= currentVenue ? currentVenue.fb_admin_psids || '' : '' %>" placeholder="e.g. 827361524389102" class="form-input font-mono-code text-xs">
          <p class="text-[10px] text-slate-400 mt-1">Your Page-Scoped ID (PSID) received when messaging your Facebook Page.</p>
        </div>

        <div class="pt-2">
          <button type="submit" class="btn-primary-green w-full py-2.5 text-xs font-bold shadow-sm">
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>Save Facebook Messenger Settings</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Live Test Ping Column (5 cols) -->
    <div class="lg:col-span-5 glass-card p-6 space-y-4">
      <div class="pb-2 border-b border-slate-100">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Live Integration Test</h3>
        <p class="text-[11px] text-slate-500 mt-0.5">Send a simulated booking notification to verify Meta Graph API connectivity.</p>
      </div>

      <form action="/admin/messenger/test" method="POST" class="space-y-3">
        <div>
          <label class="form-label">Target Admin PSID for Test</label>
          <input type="text" name="test_psid" required placeholder="Enter PSID to ping" value="<%= (currentVenue && currentVenue.fb_admin_psids) ? currentVenue.fb_admin_psids.split(',')[0].trim() : '' %>" class="form-input font-mono-code text-xs">
        </div>

        <button type="submit" class="btn-secondary-white w-full py-2.5 text-xs font-bold">
          <i data-lucide="send" class="w-4 h-4 text-brand-700"></i>
          <span>Send Test Messenger Ping</span>
        </button>
      </form>
    </div>

  </div>

</div>
